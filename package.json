{
  "name": "music-connect",
  "version": "1.0.0",
  "description": "Listen and share music of your taste",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "server": "nodemon server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules' jest --testTimeout=5000 --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebraudalf/musi-connect-frontend.git"
  },
  "keywords": [
    "music",
    "connect",
    "backend",
    "frontend"
  ],
  "author": "music-connect-team",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thebraudalf/musi-connect-frontend/issues"
  },
  "homepage": "https://github.com/thebraudalf/musi-connect-frontend#readme",
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/node": "^25.6.0",
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.6.0",
    "cloudinary-build-url": "^0.2.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "deep-email-validator": "^0.1.27",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.4.1",
    "groq-sdk": "^0.19.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^8.0.7",
    "smtpapi": "^1.4.7",
    "socket.io": "^4.8.1",
